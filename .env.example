# Copy to .env and fill in.
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Leave unset to use SQLite locally (and the bundled demo database on Vercel —
# see VERCEL.md). For PostgreSQL:
# DATABASE_URL=postgres://user:password@localhost:5432/livo_os

# --- AI (Groq Cloud; comma-separate keys to rotate on failure) ---
# Get keys at https://console.groq.com/keys
GROQ_API_KEYS=
GROQ_MODEL=openai/gpt-oss-120b
